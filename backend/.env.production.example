# Replace every placeholder. Inject secret values through your deployment secret manager.
MYSQL_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=replace-with-a-unique-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
JWT_SECRET=replace-with-base64-encoded-random-key-at-least-32-bytes
JWT_ISSUER=your-jwt-issuer-uri
JWT_EXPIRATION_MS=your-token-lifetime-in-milliseconds
CORS_ALLOWED_ORIGINS=your-https-frontend-origin
FRONTEND_URL=your-https-frontend-url
IMAGE_TAG=your-release-tag
MAIL_ENABLED=replace-with-true-or-false
MAIL_FROM=your-sender-address
SMTP_HOST=your-smtp-host
SMTP_PORT=your-smtp-port
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_AUTH=replace-with-true-or-false
SMTP_STARTTLS=replace-with-true-or-false
