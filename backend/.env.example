# Local development only. Production uses injected environment variables.
# The optional .env import in application-dev.yaml is relative to the backend cwd.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/uni_lend
SHOW_SQL=false
JWT_ISSUER=http://unilend.local
MYSQL_DATABASE=uni_lend
DB_USERNAME=unilend
DB_PASSWORD=change-this-local-db-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password
JWT_SECRET=replace-with-output-of-openssl-rand-base64-32
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
MAIL_ENABLED=false
MAIL_FROM=no-reply@unilend.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_EMAIL_MAX=3
RATE_LIMIT_EMAIL_WINDOW_SECONDS=900

# Optional local fixtures. Set true only for an isolated dev/demo database.
SEED_ENABLED=false
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
