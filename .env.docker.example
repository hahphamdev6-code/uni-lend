# Local Docker stack. Generate .env.docker using scripts/Init-DockerEnv.ps1.
# Never commit .env.docker or pass secrets as Docker build arguments.
MYSQL_DATABASE=uni_lend
DB_USERNAME=unilend
DB_PASSWORD=__GENERATE_DB_PASSWORD__
MYSQL_ROOT_PASSWORD=__GENERATE_ROOT_PASSWORD__
JWT_SECRET=__GENERATE_JWT_SECRET__
JWT_ISSUER=http://localhost:8080
JWT_EXPIRATION_MS=86400000
FRONTEND_PORT=3000
BACKEND_PORT=8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAIL_ENABLED=false
MAIL_FROM=no-reply@unilend.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
